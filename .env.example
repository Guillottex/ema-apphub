# ══════════════════════════════════════════════════════════════
#  EMA AppHub — variables de entorno
#  cp .env.example .env   (o ejecutar scripts/install.sh, que genera los secretos)
# ══════════════════════════════════════════════════════════════

TZ=America/Argentina/Buenos_Aires

# ── Acceso a la plataforma ──
# Dominio de la interfaz (vía Traefik con HTTPS). Sin DNS: use http://IP:PLATFORM_HTTP_PORT
PLATFORM_DOMAIN=apphub.emaservicios.com.ar
PLATFORM_HTTP_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
# Email para certificados Let's Encrypt
ACME_EMAIL=sistemas@emaservicios.com.ar
# true SOLO si se accede siempre por HTTPS (si accede por http://IP:8080 debe ser false)
COOKIE_SECURE=false
# Orígenes extra permitidos (separados por coma). Vacío = mismo origen.
CORS_ORIGINS=

# ── Base de datos de la plataforma ──
POSTGRES_DB=apphub
POSTGRES_USER=apphub
POSTGRES_PASSWORD=CAMBIAR_password_largo_y_aleatorio

# ── Secretos (generar con: openssl rand -hex 32) ──
JWT_SECRET=CAMBIAR_openssl_rand_hex_32
# Clave maestra de cifrado de credenciales/variables. ¡Respaldarla! Sin ella no se pueden descifrar los secretos.
MASTER_KEY=CAMBIAR_openssl_rand_hex_32
JWT_EXPIRES_HOURS=8

# ── Usuario inicial (se crea sólo si no hay usuarios; se pide cambiar la contraseña) ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=sistemas@emaservicios.com.ar
ADMIN_PASSWORD=CAMBIAR_Admin12345

# ── Almacenamiento ──
# Carpeta del HOST con código, versiones, compose, backups. Se monta con la misma ruta en el backend.
DATA_DIR=/opt/ema-apphub/data

# ── Aplicaciones desplegadas ──
APPS_NETWORK=ema_apps
# IP o nombre del servidor para armar URLs http://PUBLIC_HOST:puerto
PUBLIC_HOST=192.168.1.100
# Dominio base sugerido para apps (ej: crm.emaservicios.com.ar)
APPS_BASE_DOMAIN=emaservicios.com.ar
TRAEFIK_ENABLED=true
PORT_RANGE_START=8100
PORT_RANGE_END=8999

# ── Límites y tiempos ──
MAX_UPLOAD_MB=500
BUILD_TIMEOUT_MIN=30
DEPLOY_HEALTH_WAIT_SEC=90
HEALTH_INTERVAL_SEC=60

# ── Terminal web (sólo usuarios con permiso terminal.access) ──
TERMINAL_ENABLED=true
